# ==============================================================================
# .gitignore para Java, Python, Visual Studio y carpetas custom
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. JAVA
# ------------------------------------------------------------------------------
# Archivos compilados y empaquetados
*.class
*.ctxt
.mtj.tmp/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Logs de error de la máquina virtual de Java
hs_err_pid*
replay_pid*

# Herramientas de construcción comunes (Maven/Gradle)
target/
build/
.gradle/

# ------------------------------------------------------------------------------
# 2. PYTHON
# ------------------------------------------------------------------------------
# Archivos compilados y caché
__pycache__/
*.py[codz]
*$py.class
*.so

# Entornos virtuales y variables de entorno
.env
.venv
env/
venv/
ENV/

# Archivos específicos de tu proyecto
/backendBotTrading/envs/.env
backendBotTrading/.env

# Empaquetado y testing
dist/
eggs/
.eggs/
*.egg-info/
*.egg
.tox/
.nox/
.coverage
htmlcov/
.pytest_cache/

# ------------------------------------------------------------------------------
# 3. VISUAL STUDIO Y VISUAL STUDIO CODE
# ------------------------------------------------------------------------------
# Visual Studio (IDE completo)
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
Debug/
Release/
x64/
x86/
[Bb]in/
[Oo]bj/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.code-workspace

# ------------------------------------------------------------------------------
# 4. CARPETAS CUSTOM: LOGS Y RESULTS
# ------------------------------------------------------------------------------
# Ignora todo el contenido dentro de estas carpetas, así como cualquier archivo .log general
logs/
results/
*.log
models/
# ------------------------------------------------------------------------------
# 5. ARCHIVOS DEL SISTEMA OPERATIVO
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db


# ------------------------------------------------------------------------------
# VISUAL STUDIO CODE
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Historial local y áreas de trabajo
.history/
*.code-workspace