#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
BACKEND_DIR="$REPO_ROOT/code/backendBotTrading"

if [[ ! -d "$BACKEND_DIR" ]]; then
  echo "[pre-push] ERROR: No existe $BACKEND_DIR"
  exit 1
fi

echo "[pre-push] Ejecutando quality gate (mvn clean verify)..."
cd "$BACKEND_DIR"
mvn clean verify

echo "[pre-push] OK: quality gate superado."
